<?xml version="1.0" encoding="UTF-8"?>
<!--
    五恒智能控制系统 - Lint配置文件

    版本: 1.0
    更新日期: 2026-04-23

    配置说明:
    - 禁用会导致StackOverflowError的检查
    - 跳过某些已知问题的检查
    - 保持代码质量的同时确保编译通过
-->
<lint>
    <!--
        禁用会导致StackOverflowError的检查
        这些检查在大型Compose项目中可能导致递归
    -->

    <!-- 禁用IconDipSize检查 - 可能导致栈溢出 -->
    <issue id="IconDipSize" severity="ignore" />

    <!-- 禁用IconLocation检查 -->
    <issue id="IconLocation" severity="ignore" />

    <!-- 禁用IconDensities检查 -->
    <issue id="IconDensities" severity="ignore" />

    <!-- 禁用IconExpectedSize检查 -->
    <issue id="IconExpectedSize" severity="ignore" />

    <!--
        禁用某些资源检查以避免递归
    -->

    <!-- 禁用UnusedResources检查 - Release构建时可能导致问题 -->
    <issue id="UnusedResources" severity="ignore" />

    <!-- 禁用TypographyQuotes检查 -->
    <issue id="TypographyQuotes" severity="ignore" />

    <!--
        网络和安全配置相关
    -->

    <!-- 禁用TrustAllX509TrustManager检查 - 我们使用系统证书 -->
    <issue id="TrustAllX509TrustManager" severity="ignore" />

    <!-- 禁用BadHostnameVerifier检查 -->
    <issue id="BadHostnameVerifier" severity="ignore" />

    <!--
        禁用某些可能导致性能问题的检查
    -->

    <!-- 禁用Overdraw检查 -->
    <issue id="Overdraw" severity="ignore" />

    <!-- 禁用UnusedAttribute检查 -->
    <issue id="UnusedAttribute" severity="ignore" />

    <!--
        禁用某些Compose相关检查
    -->

    <!-- 禁用ComposableLambdaParameter检查 -->
    <issue id="ComposableLambdaParameter" severity="ignore" />

    <!-- 禁用ComposeParameterOrder检查 -->
    <issue id="ComposeParameterOrder" severity="ignore" />

    <!--
        其他配置
    -->

    <!-- 禁用ObsoleteSdkInt检查 -->
    <issue id="ObsoleteSdkInt" severity="ignore" />

    <!-- 禁用OldTargetApi检查 -->
    <issue id="OldTargetApi" severity="ignore" />

    <!-- 禁用GradleDependency检查 - 避免网络检查导致的延迟 -->
    <issue id="GradleDependency" severity="ignore" />

    <!-- 禁用NewerVersionAvailable检查 -->
    <issue id="NewerVersionAvailable" severity="ignore" />

    <!--
        保持启用的重要检查（设置为error级别）
    -->

    <!-- 硬编码文本 -->
    <issue id="HardcodedText" severity="error" />

    <!-- 内容描述缺失 -->
    <issue id="ContentDescription" severity="warning" />

    <!-- 文本字段缺少inputType -->
    <issue id="TextFields" severity="error" />

    <!-- 可访问性 -->
    <issue id="ClickableViewAccessibility" severity="warning" />

</lint>
