<?xml version="1.0" encoding="utf-8"?>
<!--
    五恒智能控制系统 - 网络安全配置文件
    
    版本: 1.0
    更新日期: 2026-04-23
    
    配置说明:
    - 生产环境: 禁用明文流量传输 (cleartextTrafficPermitted="false")
    - 开发环境: 可临时启用明文流量 (cleartextTrafficPermitted="true")
    - 证书固定: 配置服务器证书SHA-256哈希值，防止中间人攻击
    - 调试配置: 仅在debug构建中启用
-->
<network-security-config xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!--
        基础安全配置
        生产环境必须禁用明文流量传输
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- 信任系统预装CA证书 -->
            <certificates src="system"/>
            <!-- 信任用户添加的CA证书（仅用于调试） -->
            <!-- <certificates src="user"/> -->
        </trust-anchors>
    </base-config>
    
    <!-- 
        开发环境配置 (Debug Only)
        用于开发测试，允许明文流量和自签名证书
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <!-- 开发环境允许用户证书（Charles/Fiddler抓包） -->
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
    
    <!--
        特定域名配置
        为特定API服务器配置独立的安全策略
    -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- 生产API服务器 -->
        <domain includeSubdomains="true">api.wuheng.com</domain>
        <domain includeSubdomains="true">wuheng.com</domain>

        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
    
    <!--
        本地开发服务器配置 (仅开发环境使用)
        10.0.2.2: Android模拟器访问宿主机
        192.168.x.x: 局域网测试服务器
        116.62.51.112: 五恒测试服务器
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android模拟器宿主机 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 本地回环 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- 局域网测试服务器（根据实际情况调整） -->
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.0.100</domain>
        <!-- 五恒测试服务器 (HTTP明文通信) -->
        <domain includeSubdomains="false">116.62.51.112</domain>

        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    
    <!--
        MQTT服务器配置（如使用TLS）
        配置MQTT over TLS的安全连接
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mqtt.wuheng.com</domain>

        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
    
</network-security-config>
